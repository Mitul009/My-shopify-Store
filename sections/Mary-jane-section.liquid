<section class="mery_section">
  <a href="{{ section.settings.shop_url }}">
    <div class="mery_wrapper">
      <div class="mery_main_img">
        <img src="{{ section.settings.mery_img | img_url: 'master'}}">
      </div>
      <div class="mery_info">
        <div class="mery_info_inner">
          <p>{{ section.settings.sub_heading }}</p>
          <h3>{{ section.settings.heading }}</h3>
          <button>{{ section.settings.button_text }}</button>
        </div>
      </div>
    </div>
  </a>
</section>

{% schema %}
  {
    "name": "mery section",
    "settings": [
      {
        "type": "url",
        "id": "shop_url",
        "label": "Shop Link"
      },
      {
        "type": "image_picker",
        "id": "mery_img",
        "label": "BG Image"
      },
      {
        "type": "richtext",
        "id": "sub_heading",
        "label": "Sub Heading"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "text",
        "id": "button_text",
        "label": "BUtton Text"
      },
    ],
    "presets": [
      {
        "name": "Mery section"
      }
    ]
  }
{% endschema %}